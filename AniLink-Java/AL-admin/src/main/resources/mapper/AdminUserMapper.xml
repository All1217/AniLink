<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.video.admin.mapper.AdminUserMapper">

    <sql id="adminUserColumns">
        uid, username, nickname, avatar, status, role, create_date
    </sql>

    <select id="pageAdmin" resultType="com.video.admin.vo.AdminUserVo">
        select
        <include refid="adminUserColumns"/>
        from user
        <where>
            <if test="query.keyword != null and query.keyword != ''">
                and (username like concat('%', #{query.keyword}, '%')
                or nickname like concat('%', #{query.keyword}, '%')
                or cast(uid as char) = #{query.keyword})
            </if>
            <if test="query.status != null">
                and status = #{query.status}
            </if>
            <if test="query.role != null">
                and role = #{query.role}
            </if>
        </where>
        order by create_date desc, uid desc
    </select>

    <select id="getAdminDetail" resultType="com.video.admin.vo.AdminUserVo">
        select
        <include refid="adminUserColumns"/>
        from user
        where uid = #{uid}
    </select>
</mapper>
