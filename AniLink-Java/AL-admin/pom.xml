<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.video</groupId>
        <artifactId>AniLink-cloud</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>AL-admin</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-web</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-mq</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-redis</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- Phase 5：管理端不再直连业务库，去掉 MyBatis/DataSource 启动依赖 -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 管理端角色/资料校验走 al-user 的内部契约，不直连 user 表做鉴权 -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-user-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- Phase 5：用户/视频管理读写全部走内部契约，管理端不再持有业务库 Mapper -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-video-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 分页响应仍沿用 MyBatis-Plus 的 IPage/Page 结构；只引类库，不引 boot starter 因而不建 DataSource -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-auth-resource-sdk</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
