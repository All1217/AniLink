<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.video</groupId>
        <artifactId>AniLink-cloud</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>AL-social</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-web</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 收藏状态变更事件：通过 RabbitMqHelper 投递 favorite.changed -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-mq</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-common-mybatis</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 粉丝/关注列表补全用户昵称、头像：调用 al-user 内部批量接口，不 JOIN user 表 -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-user-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 收藏列表补全视频标题/封面/统计：调用 al-video 内部批量接口，不 JOIN video/video_stats -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-video-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 本服务内部契约 DTO（/internal/v1/social/** 的返回类型）放在 AL-social-api -->
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-social-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.video</groupId>
            <artifactId>AL-auth-resource-sdk</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- 用户/视频摘要本地短 TTL 缓存，避免列表页逐条 Feign -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
